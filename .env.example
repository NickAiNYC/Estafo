# VANGUARD // ESTAFO PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development. Never commit .env or secrets to Git.

# NYC Open Data App Token (Optional - increases SODA API rate limits from 1,000/hr to 50,000/hr)
# Register free at: https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_OPEN_DATA_APP_TOKEN=

# Persistent Storage Database URL (PostgreSQL / Supabase / Neon / Vercel Postgres)
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/vanguard
DATABASE_URL=

# Cron Security Secret (Protects /api/cron/ingest from unauthorized execution)
# Generate random 32-char hex string: openssl rand -hex 16
CRON_SECRET=

# Telemetry / Operations Environment
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SYSTEM_VERSION=2.4.0
